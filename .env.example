# Spot read credentials are required for account-specific trading fees, even in paper mode.
# Also used for Futures fee queries; use keys belonging to the same Kraken account.
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
# Separate Kraken Derivatives credentials. Read-only for browsing/accounts.
# Order permissions are needed only for explicitly armed live Futures; never enable withdrawals.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_PRIVATE_KEY=
# Separate Alpaca PAPER credentials. Live Alpaca credentials/endpoints are not supported.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Hosted simulated orders still require explicit permission and Start confirmation.
ALLOW_ALPACA_PAPER_TRADING=false
# Initial exchange for a new installation; the dashboard's saved selection takes precedence.
KAIROS_EXCHANGE=kraken
JEV_API_KEY=

# Runtime only; credentials never go to the browser.
JEV_MODEL=jev-latest
ALLOW_LIVE_TRADING=false
# Futures writes require BOTH flags plus explicit UI confirmation and prefunded USD collateral.
ALLOW_FUTURES_TRADING=false
PUBLIC_ORIGIN=http://127.0.0.1:8000
PORT=8000
DATA_DIR=data
