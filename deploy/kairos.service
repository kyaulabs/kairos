[Unit]
Description=Kairos dashboard and API gateway
After=network-online.target kairos-worker.service
Wants=network-online.target kairos-worker.service

[Service]
Type=simple
User=kairos
Group=kairos
WorkingDirectory=/srv/kairos
ExecStart=/srv/kairos/.venv/bin/kairos
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kairos/data

[Install]
WantedBy=multi-user.target
